---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ViewCounter from "../../components/ViewCounter.astro";
import DateMeta from "../../components/DateMeta.astro";
import { PROJECTS_BASE_PAGE_DESCRIPTION, SITE_TITLE, WORKER_URL } from "../../consts";
import "../../styles/pages/projects.css";

const projects = (await getCollection("projects"))
	.filter((item) => !item.data.draft)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Projects | ${SITE_TITLE}`}
			description={PROJECTS_BASE_PAGE_DESCRIPTION}
		/>
	</head>
	<body>
		<Header />
		<main class="projects-page">
			<h1>Projects</h1>
			<ul>
				{
					projects.map((item) => (
						<li>
							<a
								href={item.data.codeUrl || `${import.meta.env.BASE_URL.replace(/\/$/, "")}/projects/${item.id}/`}
								target={item.data.codeUrl ? "_blank" : undefined}
								rel={item.data.codeUrl ? "noopener noreferrer" : undefined}
							>
								<h2 class="report-title">{item.data.title}</h2>
							</a>
							{item.data.subtitle && (
								<p class="report-abstract">{item.data.subtitle}</p>
							)}
							<div class="report-meta">
								{(() => {
									const latestDate = item.data.revisions && item.data.revisions.length > 0
										? item.data.revisions.sort((a, b) => b.date.valueOf() - a.date.valueOf())[0].date
										: item.data.date;
									return (
										<DateMeta date={latestDate} as="span" />
									);
								})()}
								<ViewCounter slug={`projects/${item.id}`} workerUrl={WORKER_URL} readOnly={true} />
							</div>
						</li>
					))
				}
			</ul>
			{
				projects.length === 0 && (
					<p class="no-reports">No projects published yet.</p>
				)
			}
		</main>
		<Footer />
	</body>
</html>
